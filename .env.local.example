# Spotify Now-Playing widget
# 1. Create a Spotify app: https://developer.spotify.com/dashboard
# 2. Add http://localhost:3000 as a Redirect URI in the app settings
# 3. Run the one-time auth flow to get a refresh_token (see README.md)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Valorant Live-Rank widget (Henrik Dev API — no auth required)
# Just your Riot ID — e.g. NEXT_PUBLIC_RIOT_NAME=harshith NEXT_PUBLIC_RIOT_TAG=NA1
NEXT_PUBLIC_RIOT_NAME=
NEXT_PUBLIC_RIOT_TAG=
NEXT_PUBLIC_RIOT_REGION=na

# Optional: get a free Henrik API key for higher rate limits
# https://docs.henrikdev.xyz
HENRIK_API_KEY=

# Shared leaderboard (Vercel KV / Upstash Redis)
# Provision a free KV database from the Vercel dashboard (Storage tab → Create).
# The integration sets these two env vars automatically; pull them locally with
# `vercel env pull .env.local`, or paste them by hand below.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret used to HMAC-sign single-use leaderboard play-session tokens.
# Generate with: openssl rand -hex 32
# In dev it falls back to a process-random value (with a warn); set this in prod.
LEADERBOARD_SECRET=
